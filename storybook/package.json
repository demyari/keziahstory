{
  "name": "magical-storybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline, interactive choose-your-own-adventure picture book for young children.",
  "scripts": {
    "start": "node tests/tools/serve.cjs 8080",
    "test": "node --test tests/engine.test.mjs tests/memory-learning-save.test.mjs tests/variation.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/e2e.test.cjs",
    "test:all": "npm test && npm run test:browser",
    "variation-report": "node tools/simulate.mjs 150000 --report docs/VARIATION_REPORT.md",
    "build:assets": "node tools/build-asset-list.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "license": "SEE LICENSE IN docs/ASSETS.md"
}
